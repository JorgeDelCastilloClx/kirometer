            "uid": "kiro-usage"
          },
          "rawSql": "SELECT usage_date::timestamptz AS time,\n       user_label AS metric,\n       sum(credits_used) AS credits\nFROM v_usage_daily\nWHERE $__timeFilter(usage_date)\n  AND client_type IN (${client_type:sqlstring})\n  AND user_label IN (${user:sqlstring})\n  AND subscription_tier IN (${subscription:sqlstring})\nGROUP BY 1, 2\nORDER BY 1, 2"
